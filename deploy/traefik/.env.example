# Copie para "deploy/traefik/.env".
# Usuario e senha do painel do Traefik (formato htpasswd).
#
# 1) Gere o hash:
#      docker run --rm httpd:alpine htpasswd -nbB admin 'SUA_SENHA'
# 2) IMPORTANTE: no valor abaixo, DOBRE cada "$" -> "$$"
#    (o Compose interpreta "$" como variavel; "$$" vira um "$" literal).
#    Ex.: se o htpasswd gerar  admin:$2y$05$abc...  cole  admin:$$2y$$05$$abc...
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$DOBRE_OS_CIFRAO_E_COLE_O_HASH_AQUI

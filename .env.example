# Copie este arquivo para ".env" e ajuste os valores.
# O docker-compose le o .env automaticamente.

# ---- Banco de dados (PostgreSQL) ----
DB_NAME=semeando
DB_USER=semeando
DB_PASSWORD=troque-esta-senha

# ---- Segurança (JWT) ----
# Segredo de assinatura dos tokens. Mínimo 32 caracteres, aleatório e secreto.
# Gere um com:  openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-no-minimo-32-caracteres
